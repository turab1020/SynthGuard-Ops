# Streamlit UI for Render (free tier: 512 MB RAM, port from $PORT).
# It only calls the API over HTTP (SYNTHGUARD_API_URL), so no model or training code is inside.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    SYNTHGUARD_API_URL=https://synthguard-ops.onrender.com \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app
COPY ui/requirements.txt .
RUN pip install -r requirements.txt
COPY ui ./ui

RUN useradd --create-home --uid 1000 synthguard
USER synthguard

EXPOSE 8501
CMD ["sh", "-c", "streamlit run ui/app.py --server.port ${PORT:-8501} --server.address 0.0.0.0 --server.headless true"]
